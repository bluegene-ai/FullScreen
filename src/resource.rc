// ============================================================
// FullScreen Browser - Dialog Resources
// ============================================================
#include <Windows.h>
#include <CommCtrl.h>
#include "resource.h"

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION
PRODUCTVERSION  APP_VERSION
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName",      ""
            VALUE "FileDescription",  "FullScreen Browser"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "FullScreenBrowser"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "FullScreenBrowser.exe"
            VALUE "ProductName",      "FullScreen Browser"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

// ============================================================
// Config Dialog (IDD_CONFIG_DIALOG)
// ============================================================
IDD_CONFIG_DIALOG DIALOGEX 0, 0, 390, 518
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FullScreen Browser - Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Target URL:", IDC_STATIC, 12, 14, 80, 12
    EDITTEXT        IDC_URL, 12, 28, 366, 14, ES_AUTOHSCROLL

    LTEXT           "Password:", IDC_STATIC, 12, 54, 80, 12
    EDITTEXT        IDC_PASSWORD, 12, 68, 180, 14, ES_PASSWORD | ES_AUTOHSCROLL

    LTEXT           "Confirm:", IDC_STATIC, 204, 54, 80, 12
    EDITTEXT        IDC_CONFIRM_PASSWORD, 204, 68, 174, 14, ES_PASSWORD | ES_AUTOHSCROLL

    LTEXT           "Unreachable message:", IDC_STATIC, 12, 96, 120, 12
    EDITTEXT        IDC_UNREACHABLE_MSG, 12, 110, 366, 40, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL

    LTEXT           "Zoom:", IDC_STATIC, 12, 164, 80, 12
    EDITTEXT        IDC_ZOOM, 12, 178, 50, 14, ES_NUMBER
    CONTROL         "", IDC_ZOOM_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_AUTOBUDDY |
                    UDS_ALIGNRIGHT | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT           "% (50-300)", IDC_STATIC, 70, 180, 60, 12

    GROUPBOX        "Auto refresh", IDC_STATIC, 12, 196, 366, 60
    AUTORADIOBUTTON "Off", IDC_RADIO_REFRESH_OFF, 24, 210, 60, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Every", IDC_RADIO_REFRESH_INTERVAL, 24, 228, 60, 12
    AUTORADIOBUTTON "Daily at", IDC_RADIO_REFRESH_DAILY, 24, 246, 60, 12
    EDITTEXT        IDC_REFRESH_INTERVAL, 92, 226, 60, 14, ES_NUMBER
    LTEXT           "seconds", IDC_STATIC, 158, 230, 50, 12
    EDITTEXT        IDC_REFRESH_DAILY, 92, 244, 150, 14, ES_AUTOHSCROLL
    LTEXT           "HH:MM,HH:MM (24h)", IDC_STATIC, 246, 248, 130, 12

    CONTROL         "Enable burn-in prevention (pixel shift)", IDC_BURNIN_CHECK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 266, 230, 14

    CONTROL         "Start automatically at Windows login", IDC_AUTOSTART_CHECK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 286, 260, 14

    CONTROL         "Enable remote configuration", IDC_REMOTE_ENABLE,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 306, 150, 14
    LTEXT           "Remote server URL:", IDC_STATIC, 12, 326, 110, 12
    EDITTEXT        IDC_REMOTE_BASE_URL, 12, 340, 366, 14, ES_AUTOHSCROLL

    GROUPBOX        "Auto update", IDC_STATIC, 12, 358, 366, 118
    CONTROL         "Enable automatic updates", IDC_AUTO_UPDATE_CHECK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 372, 180, 14
    AUTORADIOBUTTON "GitHub releases", IDC_RADIO_UPDATE_GITHUB, 24, 392, 120, 12,
                    WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Self-hosted server", IDC_RADIO_UPDATE_SELF, 150, 392, 130, 12
    LTEXT           "GitHub repo (owner/repo):", IDC_STATIC, 24, 410, 150, 12
    EDITTEXT        IDC_UPDATE_REPO, 24, 424, 166, 14, ES_AUTOHSCROLL
    LTEXT           "Update dir URL:", IDC_STATIC, 204, 410, 90, 12
    EDITTEXT        IDC_UPDATE_BASE_URL, 204, 424, 160, 14, ES_AUTOHSCROLL
    LTEXT           "Maintenance window HH:MM-HH:MM (optional):", IDC_STATIC, 24, 444, 250, 12
    EDITTEXT        IDC_UPDATE_WINDOW, 24, 458, 166, 14, ES_AUTOHSCROLL

    LTEXT           "", IDC_URL_STATUS, 12, 486, 366, 12

    DEFPUSHBUTTON   "OK", IDOK, 210, 500, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 270, 500, 50, 14
    PUSHBUTTON      "Test URL", IDC_BTN_TEST_URL, 330, 500, 50, 14
END

// ============================================================
// Password Dialog (IDD_PASSWORD_DIALOG)
// ============================================================
IDD_PASSWORD_DIALOG DIALOGEX 0, 0, 260, 90
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password Verification"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Enter password:", IDC_STATIC, 12, 14, 120, 12
    EDITTEXT        IDC_PWD_INPUT, 12, 30, 236, 14, ES_PASSWORD | ES_AUTOHSCROLL

    DEFPUSHBUTTON   "OK", IDOK, 114, 60, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 186, 60, 60, 14
END

// ============================================================
// Menu Dialog (IDD_MENU_DIALOG)
// ============================================================
IDD_MENU_DIALOG DIALOGEX 0, 0, 200, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Action"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Exit Program", IDC_BTN_EXIT, 50, 18, 100, 28
    PUSHBUTTON      "Modify Settings", IDC_BTN_SETTINGS, 50, 56, 100, 28
    PUSHBUTTON      "Cancel", IDC_BTN_CANCEL, 50, 94, 100, 28
END

// ============================================================
// Register Dialog (IDD_REGISTER_DIALOG)
// ============================================================
IDD_REGISTER_DIALOG DIALOGEX 0, 0, 300, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Device Registration"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Enter one-time registration code:", IDC_STATIC, 12, 14, 200, 12
    EDITTEXT        IDC_REGISTER_CODE, 12, 32, 276, 14, ES_AUTOHSCROLL
    LTEXT           "This device will continue in local mode if you cancel.", IDC_STATIC, 12, 56, 260, 12

    DEFPUSHBUTTON   "Register", IDOK, 146, 80, 68, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 220, 80, 68, 14
END