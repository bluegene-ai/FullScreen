# Server local data & secrets — auto-generated on startup (admin_auth, server_secret,
# device token hashes, audit logs, config revisions...). Never commit.
server/storage/*
!server/storage/.gitkeep
server/runtime/*
!server/runtime/.gitkeep

# Self-hosted auto-update artifacts (published exe + generated manifest);
# keep update/README.md tracked.
server/public/update/FullScreenBrowser.exe
server/public/update/latest.txt

